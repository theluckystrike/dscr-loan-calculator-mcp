  "description": "DSCR loan calculator MCP server: debt service coverage ratio, max loan, rent needed, scenarios and amortization for rental property loans.",
  "type": "module",
  "license": "MIT",
  "author": "theluckystrike",
  "mcpName": "io.github.theluckystrike/dscr-loan-calculator-mcp",
  "bin": {
